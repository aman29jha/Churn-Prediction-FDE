digraph Overview {
  rankdir=LR;
  graph [fontname="Helvetica", fontsize=11, bgcolor="white", pad=0.3];
  node [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled", margin="0.2,0.12"];
  edge [fontname="Helvetica", fontsize=9, color="#555555"];

  subgraph cluster_ingest {
    label="Ingestion"; style="rounded"; color="#888888";
    BOOT [label="Bootstrap Generator\n(one-time, local)", fillcolor="#e8daef"];
    API [label="FastAPI Service\n/events/ingest", fillcolor="#d6eaf8"];
  }

  subgraph cluster_lake {
    label="Data Lake (Iceberg on S3, Glue Catalog)"; style="rounded"; color="#888888";
    BRONZE [label="Bronze\nbronze.events", fillcolor="#cd7f32", fontcolor="white"];
    SILVER [label="Silver\nsilver.events", fillcolor="#bdc3c7"];
    GOLD [label="Gold (append-only, by run_date)\nrfm_features / churn_scores / rfm_segments", fillcolor="#f1c40f"];
    ANALYTICS_T [label="Analytics tables\nkpi_daily / segment_migration /\ncohort_retention", fillcolor="#f8c471"];
  }

  subgraph cluster_trigger {
    label="Event-driven trigger"; style="rounded"; color="#888888";
    S3EVT [label="S3 Event -> SNS -> SQS\n-> Lambda (native batching)", fillcolor="#f5b7b1"];
  }

  subgraph cluster_orch {
    label="Self-hosted Airflow on EKS\n(minimal/lite config: single scheduler,\nlightweight Postgres, no HA —\ndeliberately scoped for demo, not prod scale)";
    style="rounded"; color="#888888";
    DAG1 [label="medallion_pipeline_dag\nSilver -> Gold\n(via Spark Operator:\nSparkApplication CRs)", fillcolor="#d5f5e3"];
    DAG3 [label="training_dag\n(manual / infrequent)", fillcolor="#d5f5e3"];
    DAG4 [label="analytics_dag\n(daily, time-based)", fillcolor="#d5f5e3"];
    DAG5 [label="live_simulator_dag\n(*/10 * * * *)", fillcolor="#e8daef"];
    UI [label="Airflow UI\n(native pause/unpause + 'Trigger DAG'\n= live-demo-safe manual control,\nno kubectl needed)", shape=box3d, fillcolor="#d5f5e3"];
  }

  COMPACT [label="Compaction\nScheduledSparkApplication\n(Spark Operator's own cron —\nNOT an Airflow DAG)", fillcolor="#f8c471"];

  subgraph cluster_serve {
    label="Serving"; style="rounded"; color="#888888";
    DDB [label="DynamoDB\ncustomer_scores", fillcolor="#d6eaf8"];
    ATHENA [label="Athena\n(via Glue Catalog)", fillcolor="#d6eaf8"];
    API2 [label="FastAPI\n/score/{customer_id}", fillcolor="#d6eaf8"];
    ING [label="Ingress (ALB/nginx)", fillcolor="#fadbd8"];
  }

  subgraph cluster_model {
    label="Modeling"; style="rounded"; color="#888888";
    TRAIN [label="Training\nXGBoost + SHAP\n(plain Python, not Spark)", fillcolor="#fdebd0"];
    S3MODEL [label="S3 Model Registry", fillcolor="#fdebd0"];
  }

  subgraph cluster_obs {
    label="Observability"; style="rounded"; color="#888888";
    CW [label="CloudWatch\nLogs + EMF metrics", fillcolor="#f5eef8"];
    XRAY [label="AWS X-Ray", fillcolor="#f5eef8"];
    HIST [label="Spark History Server", fillcolor="#f5eef8"];
  }

  CONSOLE [label="Streamlit Reviewer Console\n(Basic Auth)", shape=box3d, fillcolor="#aed6f1"];

  DAG5 -> API [label="POST batch"];
  BOOT -> BRONZE [label="direct load"];
  API -> BRONZE [label="direct append"];
  BRONZE -> S3EVT;
  S3EVT -> DAG1 [label="triggers\n(schedule_interval=None)"];
  DAG1 -> SILVER;
  SILVER -> DAG1;
  DAG1 -> GOLD;
  GOLD -> DDB;
  GOLD -> ATHENA;
  SILVER -> ANALYTICS_T [style=dashed];
  GOLD -> ANALYTICS_T [style=dashed, label="historized"];
  DAG4 -> ANALYTICS_T;
  COMPACT -> BRONZE [style=dashed, label="rewrite_data_files"];
  COMPACT -> SILVER [style=dashed];
  COMPACT -> GOLD [style=dashed];
  DAG3 -> GOLD [label="reads"];
  DAG3 -> TRAIN;
  TRAIN -> S3MODEL;
  S3MODEL -> API2;
  DDB -> API2;
  API2 -> ING;
  API -> CW [style=dotted];
  API2 -> CW [style=dotted];
  DAG1 -> CW [style=dotted];
  API2 -> XRAY [style=dotted];
  DAG1 -> HIST [style=dotted];
  DAG1 -> UI [style=dotted];
  CONSOLE -> API2;
  CONSOLE -> ATHENA;
  CONSOLE -> HIST;
  CONSOLE -> CW;
  CONSOLE -> UI [style=dashed, label="link out"];
}
