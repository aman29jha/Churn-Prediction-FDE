digraph DataPlatform {
  rankdir=TB;
  graph [fontname="Helvetica", fontsize=11, bgcolor="white", pad=0.3];
  node [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled", margin="0.2,0.12"];
  edge [fontname="Helvetica", fontsize=9, color="#555555"];

  subgraph cluster_eks {
    label="EKS"; style="rounded"; color="#888888";

    subgraph cluster_karpenter {
      label="Karpenter-managed EC2 NodePools\n(via Spark Operator: SparkApplication /\nScheduledSparkApplication CRDs)"; style="rounded"; color="#aaaaaa";
      NP_OD [label="NodePool: on-demand\n(Spark drivers)", shape=component, fillcolor="#f5b7b1"];
      NP_SPOT [label="NodePool: spot\n(Spark executors)", shape=component, fillcolor="#a9dfbf"];
      SILVERJOB [label="Silver Spark Job\ndriver (on-demand) +\n1-2 executors (spot)", fillcolor="#bdc3c7"];
      GOLDJOB [label="Gold Spark Job\nRFM+extras, apply model,\nRFM quintile segments\ndriver (on-demand) + executors (spot)", fillcolor="#f1c40f"];
      COMPACTJOB [label="Compaction Spark Job\nrewrite_data_files\nexpire_snapshots\ndriver (on-demand) + executors (spot)", fillcolor="#f8c471"];
      NP_OD -> SILVERJOB [style=dotted, label="driver pod"];
      NP_SPOT -> SILVERJOB [style=dotted, label="executor pods"];
    }

    subgraph cluster_fargate {
      label="Fargate profile\n(steady lightweight services)"; style="rounded"; color="#aaaaaa";
      HIST [label="Spark History Server\n(always-on Deployment)", fillcolor="#f5eef8"];
    }
  }

  IMG [label="docker/spark-jobs image\n(PySpark + Iceberg jars)\n-> ECR", shape=cylinder, fillcolor="#e8daef"];

  BRONZE [label="Bronze\ns3://.../bronze/\n(plain JSON, append-only,\nNOT an Iceberg table)", fillcolor="#cd7f32", fontcolor="white"];
  SILVER [label="Silver\nsilver.events\n(deduped, validated,\ntyped)", fillcolor="#bdc3c7"];
  GOLD_F [label="Gold: rfm_features", fillcolor="#f1c40f"];
  GOLD_S [label="Gold: rfm_segments\n(quintile baseline)", fillcolor="#f1c40f"];
  GOLD_C [label="Gold: churn_scores", fillcolor="#f1c40f"];
  DYNAMO [label="DynamoDB\ncustomer_scores\n(real-time serving lookup)", shape=cylinder, fillcolor="#2e86c1", fontcolor="white"];

  GLUE [label="AWS Glue Data Catalog", shape=component, fillcolor="#d6eaf8"];
  ATHENA [label="Athena", fillcolor="#d6eaf8"];
  EVENTLOG [label="S3: spark-events/\n(event logs)", shape=cylinder, fillcolor="#f5eef8"];

  IMG -> SILVERJOB;
  IMG -> GOLDJOB;
  IMG -> COMPACTJOB;
  IMG -> HIST;

  BRONZE -> SILVERJOB [label="dedup by event_id,\nvalidate, standardize"];
  SILVERJOB -> SILVER;
  SILVER -> GOLDJOB [label="live: as_of=now(),\nno held-out gap\n(offline train/eval:\ncutoff T = as_of-60d)"];
  GOLDJOB -> GOLD_F;
  GOLDJOB -> GOLD_S;
  GOLDJOB -> GOLD_C;
  GOLDJOB -> DYNAMO [label="every run\n(--dynamodb-table)", color="#2e86c1"];

  COMPACTJOB -> BRONZE [style=dashed, dir=back];
  COMPACTJOB -> SILVER [style=dashed, dir=back];
  COMPACTJOB -> GOLD_F [style=dashed, dir=back];

  SILVER -> GLUE [style=dotted];
  GOLD_F -> GLUE [style=dotted];
  GLUE -> ATHENA;

  SILVERJOB -> EVENTLOG [style=dotted];
  GOLDJOB -> EVENTLOG [style=dotted];
  EVENTLOG -> HIST;
}
