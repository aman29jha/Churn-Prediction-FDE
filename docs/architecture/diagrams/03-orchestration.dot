digraph Orchestration {
  rankdir=LR;
  graph [fontname="Helvetica", fontsize=11, bgcolor="white", pad=0.3];
  node [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled", margin="0.2,0.12"];
  edge [fontname="Helvetica", fontsize=9, color="#555555"];

  BRONZE [label="Bronze Iceberg\n(new data file written)", fillcolor="#cd7f32", fontcolor="white"];
  S3EVT [label="S3 Event Notification\ns3:ObjectCreated:*", shape=note, fillcolor="#fdebd0"];
  SNS [label="SNS Topic\nbronze-data-arrived", fillcolor="#f5b7b1"];
  SQS [label="SQS Queue\nbronze-data-arrived-queue", fillcolor="#f5b7b1"];
  LAMBDA [label="Lambda\nSQS event-source mapping:\nBatchSize=20 OR\nMaxBatchingWindow=300s\n(native AWS batching,\nwhichever fires first)", fillcolor="#a9dfbf"];

  subgraph cluster_sparkop {
    label="Spark Operator (installed controller + CRDs + webhook)"; style="rounded"; color="#888888";
    CRD_APP [label="CRD: SparkApplication\n(on-demand, one-shot)", shape=component, fillcolor="#d5f5e3"];
    CRD_SCHED [label="CRD: ScheduledSparkApplication\n(native cron, e.g. hourly)", shape=component, fillcolor="#d5f5e3"];
  }

  subgraph cluster_airflow {
    label="Self-hosted Airflow on EKS (Helm, KubernetesExecutor)"; style="rounded"; color="#888888";

    API_TRIGGER [label="Airflow REST API\nPOST /dags/medallion_pipeline_dag/dagRuns", shape=component, fillcolor="#d5f5e3"];

    subgraph cluster_dag1 {
      label="medallion_pipeline_dag\n(schedule_interval=None,\ntriggered, not cron-polled)"; style="rounded"; color="#aaaaaa";
      SILVER_T [label="Silver task\nSparkKubernetesOperator\n(creates SparkApplication CR)", fillcolor="#bdc3c7"];
      GOLD_T [label="Gold task\nSparkKubernetesOperator\n(creates SparkApplication CR)", fillcolor="#f1c40f"];
      SILVER_T -> GOLD_T [label="real dependency,\nretries on failure"];
    }

    subgraph cluster_dag3 {
      label="training_dag (manual trigger / infrequent)"; style="rounded"; color="#aaaaaa";
      TRAIN_T [label="Training task\n(KubernetesPodOperator,\nplain Python/XGBoost, no Spark)", fillcolor="#fdebd0"];
    }

    subgraph cluster_dag4 {
      label="live_simulator_dag (*/10 * * * *)"; style="rounded"; color="#aaaaaa";
      SIM_T [label="Simulator task\n(KubernetesPodOperator)\npause/unpause via native\nAirflow DAG toggle", fillcolor="#e8daef"];
    }

    UI [label="Airflow UI\nDAG run history, retries,\nlogs, pause/unpause toggle\nper DAG", shape=box3d, fillcolor="#d5f5e3"];
  }

  COMPACT_SA [label="Compaction ScheduledSparkApplication\n(no Airflow involved —\nSpark Operator's own cron)", fillcolor="#f8c471"];
  GOLD [label="Gold Iceberg", fillcolor="#f1c40f"];

  BRONZE -> S3EVT -> SNS -> SQS -> LAMBDA -> API_TRIGGER;
  API_TRIGGER -> SILVER_T;
  SILVER_T -> CRD_APP [style=dotted];
  GOLD_T -> CRD_APP [style=dotted];
  CRD_SCHED -> COMPACT_SA [style=dotted, label="fires on schedule"];
  COMPACT_SA -> BRONZE [style=dashed, label="rewrite_data_files"];
  COMPACT_SA -> GOLD [style=dashed];

  GOLD_T -> GOLD;
  GOLD -> TRAIN_T [label="reads"];
  SILVER_T -> UI [style=dotted];
  GOLD_T -> UI [style=dotted];
  TRAIN_T -> UI [style=dotted];
  SIM_T -> UI [style=dotted];
  CRD_APP -> UI [style=dotted, label="kubectl get sparkapplications"];
}
